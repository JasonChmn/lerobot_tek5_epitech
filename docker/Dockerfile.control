# Container CONTRÔLE — ROS2 Jazzy + driver SO-ARM101 (réel + sim MuJoCo)
# Build : docker compose build control
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    MUJOCO_GL=osmesa

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    libosmesa6 \
    libgl1 \
    ros-jazzy-cv-bridge \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf-transformations \
    && rm -rf /var/lib/apt/lists/*

# Packages fournis (driver + sim). ikpy installé ici : c'est aux étudiants
# de l'utiliser, pas de l'installer.
COPY core/lerobot_min /opt/so101/core
COPY sim /opt/so101/sim
RUN pip install --break-system-packages --no-cache-dir \
    /opt/so101/core /opt/so101/sim ikpy

# Workspace étudiant monté en volume (voir docker-compose.yml)
WORKDIR /ros2_ws

# Accès au bus série pour le bras réel : lancer le container avec
#   --device /dev/ttyACM0  (voir compose, service control-real)
CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && bash"]
