# Container CONTRÔLE — ROS2 Jazzy + driver SO-ARM101 (réel + sim MuJoCo) + RViz
# Build : docker compose build control
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    MUJOCO_GL=osmesa \
    PYOPENGL_PLATFORM=osmesa \
    LIBGL_ALWAYS_SOFTWARE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    libosmesa6 \
    libgl1 \
    libgl1-mesa-dri \
    ros-jazzy-cv-bridge \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf-transformations \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-rviz2 \
    && rm -rf /var/lib/apt/lists/*

# Packages fournis (driver + sim). ikpy installé ici : c'est aux étudiants
# de l'utiliser, pas de l'installer.
COPY core/lerobot_min /opt/so101/core
COPY sim /opt/so101/sim
RUN pip install --break-system-packages --no-cache-dir \
    "numpy<2" "opencv-python-headless==4.10.*" /opt/so101/core /opt/so101/sim ikpy

# Workspace étudiant monté en volume (voir docker-compose.yml)
WORKDIR /ros2_ws

# RViz : nécessite X11 forwardé (DISPLAY + /tmp/.X11-unix, voir compose)
# et `xhost +local:docker` sur l'hôte. Sans accélération GPU dans le
# container, fallback : LIBGL_ALWAYS_SOFTWARE=1 rviz2
# Accès au bus série pour le bras réel : voir compose, service control-real
CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && bash"]
